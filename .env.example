# BuildeX Coder IDE — Environment configuration
#
# 1. Copy this file to `.env`
# 2. Fill in your Pollinations API key
# 3. Restart BuildeX
#
# Get a key from: https://gen.pollinations.ai/docs

# Required for AI features (Pollinations.ai)
POLLINATIONS_API_KEY=

# Optional. Override the default endpoint or model.
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_DEFAULT_MODEL=gemini
